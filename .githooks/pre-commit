#!/bin/sh
# Chặn commit khi appsettings.json (bản đi lên git) còn giá trị secret thật.
# Bỏ qua tạm thời: git commit --no-verify
# Bật hook cho máy mới: git config core.hooksPath .githooks

fail=0

for f in $(git diff --cached --name-only --diff-filter=ACM | grep -E 'appsettings.*\.json$' | grep -v -E 'appsettings\.(Local|Development)\.json$'); do
  hits=$(git show ":$f" | grep -nE '"[A-Za-z0-9_]*([Kk]ey|[Ss]ecret|Password|Username|ClientId|ConnectionString|SaigonWaterbusDb)"[[:space:]]*:[[:space:]]*"[^"]')
  if [ -n "$hits" ]; then
    echo "-------------------------------------------------------------"
    echo "COMMIT BỊ CHẶN: $f đang chứa giá trị secret."
    echo "$hits"
    echo ""
    echo "Để giá trị rỗng \"\" trong $f, đặt giá trị thật vào:"
    echo "  - src/Web/appsettings.Local.json  (chạy local, đã gitignore)"
    echo "  - Azure App Service > Configuration  (prod)"
    echo "-------------------------------------------------------------"
    fail=1
  fi
done

# Chặn luôn việc lỡ tay add file secret local
for f in $(git diff --cached --name-only --diff-filter=ACM); do
  case "$f" in
    *appsettings.Local.json|*appsettings.Development.json|*.env|*.pem|*swb-google.json)
      echo "COMMIT BỊ CHẶN: không được commit file secret local: $f"
      fail=1
      ;;
  esac
done

exit $fail
